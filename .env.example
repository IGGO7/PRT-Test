# Copie para .env (local) e configure as mesmas variáveis no painel da Vercel.
# NUNCA versione o .env real. Todas as chaves ficam somente no servidor.

# --- IA (D23): gpt-6-luna é candidato; troque pelo modelo validado no spike ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_S=90
# gpt-5*/o*: low = mais rápido; medium = padrão da OpenAI
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_RETRIES=1

# --- Supabase (projeto PRT-CASE) ---
SUPABASE_URL=https://gjmiwygmnqkampsxzquf.supabase.co
# Chave SECRETA (sb_secret_...) ou service_role legada. Nunca a publishable/anon.
SUPABASE_SECRET_KEY=
# "supabase" em produção; "memory" só para desenvolvimento/testes.
STORAGE_BACKEND=supabase

# --- Demonstração ---
BUSINESS_DATE=2026-09-30
MAX_ANALYSES_PER_SESSION=25
MAX_BODY_CHARS=8000
MAX_ATTACHMENT_BYTES=204800
APP_ENV=production
SESSION_COOKIE_SECURE=true
# Origens extras autorizadas (ex.: preview local do frontend). Vazio = mesmo domínio.
ALLOWED_ORIGINS=
# Local: SERVE_PUBLIC=1 faz o FastAPI servir public/ (na Vercel, deixe vazio).
SERVE_PUBLIC=
